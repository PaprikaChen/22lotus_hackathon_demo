[node name="PrayerCloth" type="Area2D" parent="Props"]
position = Vector2(5800, 560)
script = ExtResource("4")
display_text = "布条曾经应该是红色，如今已经褪成浅灰。
上面写着很小的字。
其中大部分已经无法辨认。
只有一条有几个字还算清晰：
【……岁岁平安】
有人曾在这里祈福。"
prompt_text = "查看布条"

[node name="EyeAnchor" type="Marker2D" parent="Props/PrayerCloth"]
position = Vector2(8.02, -145.77)


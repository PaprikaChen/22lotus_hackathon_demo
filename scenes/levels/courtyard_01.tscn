[node name="TreeMarks" type="Area2D" parent="Props"]
position = Vector2(4950, 560)
script = ExtResource("4")
display_text = "树皮上刻着数道横线。
每条横线旁边都有年份和身高标记。最矮的一条靠近树根。
旁边写着：【两岁】
更高处还有：【三岁】【四岁】
最后一条停在四岁。
之后再没有新的刻痕。"
prompt_text = "查看树皮刻痕"


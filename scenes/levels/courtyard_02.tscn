[node name="notebook" type="Area2D" parent="Props"]
position = Vector2(4077, 541)
script = ExtResource("22")
display_text = "捡到了某人的笔记。
【怀瑾见我久病枯坐，特将天山所得异花移至窗前。其茎纤长，风来若浮空无所依，故名“浮游花”。】
【吾素爱奇花异草，见之甚喜。虽不能远行，抬眼见之，如邀天山之风入院中。——云岫】"
prompt_text = "查看花旁的纸片"

